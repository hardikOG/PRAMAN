# ── PRAMAN environment ────────────────────────────────────────────────────────
# Copy to `.env` and (optionally) fill the two secret blocks (Anthropic +
# Razorpay). Everything below runs `make demo` / `make eval` with zero
# external services out of the box — SQLite + an in-process fake Redis, no
# Docker required. Uncomment the docker-compose block if you run `make up`
# instead and want the full Postgres/Redis stack.

# Runtime
PRAMAN_ENV=local                       # local | test | prod
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# ── Data stores (zero-dependency default) ─────────────────────────────────────
# SQLite file + in-process fake Redis: no Docker, no external services. Every
# table in apps/api/models/tables.py uses portable column types for exactly
# this reason. This is what `make demo`/`make eval` run against by default.
DATABASE_URL=sqlite+aiosqlite:///./.local/praman.db
REDIS_URL=fake://local

# ── docker-compose alternative (uncomment both, and use `make up`) ────────────
# Host is `postgres`/`redis` inside the compose network; exposed on the host
# at 5434/6381 (see docker-compose.yml) — non-default ports because this dev
# machine already has native Postgres/Redis on the usual ones.
# POSTGRES_USER=praman
# POSTGRES_PASSWORD=praman
# POSTGRES_DB=praman
# DATABASE_URL=postgresql+asyncpg://praman:praman@postgres:5432/praman
# REDIS_URL=redis://redis:6379/0

# ── Anthropic (faithfulness verifier + constraint extraction) ─────────────────
# Required for the live faithfulness stage and mandate constraint extraction.
# The eval harness uses a prompt-hash response cache, so it does not re-bill.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_CACHE_DIR=.llm_cache

# ── Razorpay (test mode) ──────────────────────────────────────────────────────
# Optional. Add real test-mode keys to see a live captured Razorpay payment
# in the demo/console; without them `get_payment_executor()` (apps/api/
# payments/__init__.py) automatically falls back to `DeterministicExecutor`
# so `make demo` still runs end to end. The eval harness always uses
# DeterministicExecutor regardless of this setting — 520 scenarios never hit
# the network.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_EXECUTOR=razorpay               # razorpay | deterministic

# ── Gateway policy knobs (defaults; see apps/api/gateway/policy.py) ───────────
STEP_UP_TTL_SECONDS=900                 # 15-minute human-confirm window
AUTO_STRIP_MAX_FRACTION=0.10            # strip unrequested items under 10% of cart
VELOCITY_MAX_TXN_PER_HOUR=3             # mandate-declared cap, checked by S1
VELOCITY_MAX_TXN_PER_DAY=10
REPLAY_GUARD_TTL_SECONDS=86400          # how long a cart id is remembered to block replay

# ── S3 behaviour-stage thresholds (see apps/api/gateway/stage_behaviour.py) ───
BEHAVIOUR_MAX_REQ_PER_SEC=5.0
BEHAVIOUR_BURST_WINDOW_SECONDS=10.0
BEHAVIOUR_PROBE_WINDOW_SECONDS=300.0    # 5 minutes
BEHAVIOUR_PROBE_MIN_QUOTES=5
BEHAVIOUR_LOOP_MIN_REPEATS=3
BEHAVIOUR_EVENT_STREAM_MAXLEN=500

# ── S2 faithfulness stage (see apps/api/gateway/stage_faithfulness.py) ────────
# A SATISFIED verdict below this confidence is downgraded to UNDETERMINED —
# an uncertain LLM call must never silently authorize a payment.
FAITHFULNESS_MIN_CONFIDENCE=0.7

# ── S4 policy fusion (see apps/api/gateway/policy.py) ─────────────────────────
# A behaviour_score at or above this steps up rather than allows.
BEHAVIOUR_STEP_UP_THRESHOLD=0.4

# ── Crypto ────────────────────────────────────────────────────────────────────
# Ledger signing key (Ed25519). Generated by `make seed` if absent; never commit.
LEDGER_SIGNING_KEY_PATH=.keys/ledger_ed25519.pem

# ── Web console ───────────────────────────────────────────────────────────────
# Host-facing API port is 8010 (8000 is already bound to another Docker
# project on this dev machine's Docker Desktop backend).
VITE_API_BASE_URL=http://localhost:8010
