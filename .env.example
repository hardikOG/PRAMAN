# ── PRAMAN environment ────────────────────────────────────────────────────────
# Copy to `.env` and fill the two secret blocks (Anthropic + Razorpay).
# Everything else has working defaults for `docker compose up`.

# Runtime
PRAMAN_ENV=local                       # local | test | prod
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# ── Postgres ──────────────────────────────────────────────────────────────────
# Inside the compose network the host is `postgres`; from the host machine it
# is exposed on 5434 (see docker-compose.yml) — chosen after checking with
# Get-NetTCPConnection, since this dev machine has native Postgres on both
# 5432 and 5433 already.
POSTGRES_USER=praman
POSTGRES_PASSWORD=praman
POSTGRES_DB=praman
DATABASE_URL=postgresql+asyncpg://praman:praman@postgres:5432/praman

# ── Redis ─────────────────────────────────────────────────────────────────────
# Compose host `redis`; exposed on host 6381 (6379 and 6380 are both already
# taken on this dev machine — a native redis-server and another Docker
# project's port mapping, respectively).
REDIS_URL=redis://redis:6379/0

# ── Anthropic (faithfulness verifier + constraint extraction) ─────────────────
# Required for the live faithfulness stage and mandate constraint extraction.
# The eval harness uses a prompt-hash response cache, so it does not re-bill.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_CACHE_DIR=.llm_cache

# ── Razorpay (test mode) ──────────────────────────────────────────────────────
# Required only for the live demo payment path. The eval harness uses the
# DeterministicExecutor and never hits the network.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_EXECUTOR=razorpay               # razorpay | deterministic

# ── Gateway policy knobs (defaults; see apps/api/gateway/policy.py) ───────────
STEP_UP_TTL_SECONDS=900                 # 15-minute human-confirm window
AUTO_STRIP_MAX_FRACTION=0.10            # strip unrequested items under 10% of cart
BEHAVIOUR_MAX_REQ_PER_SEC=5.0
VELOCITY_MAX_TXN_PER_HOUR=3
VELOCITY_MAX_TXN_PER_DAY=10

# ── Crypto ────────────────────────────────────────────────────────────────────
# Ledger signing key (Ed25519). Generated by `make seed` if absent; never commit.
LEDGER_SIGNING_KEY_PATH=.keys/ledger_ed25519.pem

# ── Web console ───────────────────────────────────────────────────────────────
# Host-facing API port is 8010 (8000 is already bound to another Docker
# project on this dev machine's Docker Desktop backend).
VITE_API_BASE_URL=http://localhost:8010
